# =============================================================================
# CLINICA SAN MIGUEL - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# Email sender address for system notifications
NEXT_PUBLIC_EMAIL_SENDER_URL=noreply@alerts.myclinicmd.com

# Resend API Key for sending emails
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here


# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Supabase Project URL
# Find this in your Supabase project settings: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (Public)
# This key is safe to use in client-side code
# Find this in your Supabase project settings: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (Private - Server-side only)
# WARNING: This key has full access to your database. Never expose it to the client.
# Only use this in server-side API routes and edge functions
# Find this in your Supabase project settings: https://app.supabase.com/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here


# -----------------------------------------------------------------------------
# OPENAI CONFIGURATION
# -----------------------------------------------------------------------------
# OpenAI API Key for AI features (chatbot, data normalization)
# Get your API key from: https://platform.openai.com/api-keys
# Currently used for:
# - AI-powered data normalization (normalize-csa endpoint)
# - Chatbot functionality (currently disabled)
OPENAI_API_KEY=your_openai_api_key_here


# -----------------------------------------------------------------------------
# SMARTYSTREETS CONFIGURATION
# -----------------------------------------------------------------------------
# SmartyStreets API credentials for address validation and autocomplete
# Get your credentials from: https://www.smarty.com/account/keys
SMARTY_AUTH_ID=your_smarty_auth_id_here
SMARTY_AUTH_TOKEN=your_smarty_auth_token_here


# -----------------------------------------------------------------------------
# GOOGLE MAPS CONFIGURATION (Optional - Currently Commented Out)
# -----------------------------------------------------------------------------
# Google Maps API Key for location services
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Uncomment if you want to enable Google Maps integration
# NEXT_PUBLIC_GOOGLE_API_KEY=your_google_maps_api_key_here


# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. NEVER commit .env.local to version control
# 2. Add .env.local to your .gitignore file
# 3. Rotate all API keys regularly (every 90 days recommended)
# 4. Use different keys for development, staging, and production
# 5. Keep SUPABASE_SERVICE_ROLE_KEY secret - it has full database access
# 6. For HIPAA compliance, ensure all services have signed BAAs
# 7. Monitor API key usage for suspicious activity
# =============================================================================

# =============================================================================
# REQUIRED SERVICES & ACCOUNTS
# =============================================================================
# To run this project, you need accounts with:
# 1. Supabase (https://supabase.com) - Database & Authentication
# 2. Resend (https://resend.com) - Email delivery
# 3. SmartyStreets (https://www.smarty.com) - Address validation
# 4. OpenAI (https://openai.com) - AI features (optional)
# 5. Google Cloud (https://cloud.google.com) - Maps API (optional)
# =============================================================================

# =============================================================================
# BUSINESS ASSOCIATE AGREEMENTS (BAA) FOR HIPAA COMPLIANCE
# =============================================================================
# If handling Protected Health Information (PHI), ensure you have signed BAAs with:
# - Supabase: https://supabase.com/docs/guides/platform/hipaa
# - Resend: Contact their sales team
# - SmartyStreets: Contact their sales team
# - OpenAI: https://openai.com/enterprise-privacy
# - Vercel (hosting): https://vercel.com/legal/hipaa
# =============================================================================
