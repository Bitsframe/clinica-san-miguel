NEXT_PUBLIC_SITE_URL=https://www.clinicsanmiguel.com
NEXT_PUBLIC_EMAIL_SENDER_URL=noreply@alerts.myclinicmd.com
RESEND_API_KEY=your_resend_api_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Publishable key (sb_publishable_...) — browser-safe with RLS. Legacy: NEXT_PUBLIC_SUPABASE_ANON_KEY still works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Secret key (sb_secret_...) — server only. Legacy: SUPABASE_SERVICE_ROLE_KEY still works.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
OPENAI_API_KEY=your_openai_api_key_here
SMARTY_AUTH_ID=your_smarty_auth_id_here
SMARTY_AUTH_TOKEN=your_smarty_auth_token_here